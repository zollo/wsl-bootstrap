# Pinned tool versions. Bump here, then re-run ./bootstrap.sh tools.
# Downloads are verified against the upstream checksum file, or against the
# pinned hash below where the project doesn't publish one.
# shellcheck shell=bash disable=SC2034

KUBECTL_VERSION=1.34.7
HELM_VERSION=4.3.0
TOFU_VERSION=1.8.8
PACKER_VERSION=1.16.1

# Bitwarden CLI (bw) has no checksum file; hash from the GitHub release asset digest
# (gh api repos/bitwarden/clients/releases/tags/cli-v<ver> -q '.assets[]|select(.name=="bw-linux-<ver>.zip")|.digest').

BW_VERSION=2026.9.1
BW_SHA256_AMD64=84289eaf59d691f04242605112f21b00e8dba65acdedbc60dde001a2860f2097
BW_SHA256_ARM64=c451c773378a6f1f041ea26568a897b285a8656bee16a16e4914ce9e40fb7c79

# Bitwarden Secrets Manager CLI
BWS_VERSION=2.1.0

# mikefarah/yq (Ubuntu's apt "yq" is the unrelated Python kislyuk/yq)
YQ_VERSION=4.54.1
YQ_SHA256_AMD64=8e34fc298390875de416e6a4afcb8cabeceb25d9aa8506c1a2f9353cf702ea5f
YQ_SHA256_ARM64=189088da0c6429ec5178dfaab1a114805f6cab0b61b165ab236efedf1d57a71b
